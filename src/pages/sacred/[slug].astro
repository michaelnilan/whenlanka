---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import RelatedLinks from '../../components/astro/RelatedLinks.astro';
import StaticMap from '../../components/StaticMap';
import { MonasteryCard } from '../../components/StopDetail';
import { AffiliateButton } from '../../components/DayList';
import { climate, monasteries, placeById } from '../../lib/data';
import { paths } from '../../lib/slugs';
import { retreat } from '../../lib/affiliates';
import { itinerariesWith } from '../../lib/matrix';
import { breadcrumbs, touristAttraction } from '../../lib/jsonld';
import { haversineKm, monthName, scoreZones, type Monastery } from '../../engine';

export function getStaticPaths() {
  return monasteries.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: Monastery };
const near = placeById.get(m.nearPlace)!;
const path = paths.monastery(m.slug);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Sacred & Silent', path: '/sacred' }, { name: m.name, path }];
const km = Math.round(haversineKm(m, near));
const r = retreat(m);
const its = itinerariesWith(near.id, 3);
const others = monasteries.filter((x) => x.id !== m.id).sort((a, b) => haversineKm(m, a) - haversineKm(m, b)).slice(0, 4);
---
<Base title={`${m.name}, Sri Lanka: Visiting, Etiquette & Stays`} description={m.blurb.slice(0, 300)} path={path} jsonld={[touristAttraction(m, path), breadcrumbs(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <h1 class="text-3xl sm:text-4xl font-semibold">{m.name}</h1>
  <p class="mt-1 text-muted">About {km} km from <a href={paths.place(near.slug)}>{near.name}</a></p>
  <div class="mt-5 grid gap-6 md:grid-cols-[1fr_240px] items-start">
    <div>
      <MonasteryCard monastery={m} />
      {r && <div class="mt-3"><AffiliateButton link={r} ctx={{ place: m.id }} /><p class="text-[11px] text-muted mt-1">We may earn a commission from retreat bookings.</p></div>}
      <p class="mt-4 text-sm text-muted">Facts on this page come from the source linked above. Opening hours and stay rules change, so confirm directly before you travel. Spotted an error? <a href="/about">Tell us</a>.</p>
    </div>
    <figure class="rounded-2xl border border-line bg-white p-3">
      <StaticMap zones={climate} scores={scoreZones(2, climate).scores} monasteries={[m]} stops={[near]} width={220} className="w-full h-auto" title={`${m.name} on a map of Sri Lanka`} />
      <figcaption class="text-xs text-muted mt-1">◆ {m.name} · ● {near.name}</figcaption>
    </figure>
  </div>
  {its.length > 0 && (
    <section class="mt-8">
      <h2 class="text-2xl font-semibold mb-2">Routes that pass nearby</h2>
      <p class="text-sm text-ink/80 mb-2">Turn on <strong>Sacred &amp; Silent</strong> in the planner and this site is added to the {near.name} stop.</p>
      <ul class="space-y-1">{its.map(({ days, month }) => <li><a href={`${paths.durationMonth(days, month)}?m=${month}&d=${days}&s=1`}>{days} days in {monthName(month)} via {near.name}</a></li>)}</ul>
    </section>
  )}
  <RelatedLinks groups={[
    { title: 'Nearby sacred sites', links: others.map((o) => ({ href: paths.monastery(o.slug), label: o.name })) },
    { title: 'More', links: [{ href: '/sacred', label: 'Sacred & Silent guide' }, { href: paths.place(near.slug), label: near.name }] },
  ]} />
</Base>
