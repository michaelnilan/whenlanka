---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import FaqBlock from '../../components/astro/FaqBlock.astro';
import RelatedLinks from '../../components/astro/RelatedLinks.astro';
import StaticMap from '../../components/StaticMap';
import { MonasteryCard } from '../../components/StopDetail';
import { climate, monasteries, placeById } from '../../lib/data';
import { paths } from '../../lib/slugs';
import { breadcrumbs, faqPage } from '../../lib/jsonld';
import { scoreZones } from '../../engine';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Sacred & Silent', path: '/sacred' }];
const groups = [
  { title: 'Ancient forest monasteries', kinds: ['ancient'] },
  { title: 'Living temples', kinds: ['temple'] },
  { title: 'Where you can stay and meditate', kinds: ['forest-hermitage', 'lay-retreat'] },
];
const neutral = scoreZones(2, climate).scores;
const faq = [
  { q: 'Can foreigners stay in a Buddhist monastery in Sri Lanka?', a: 'Yes, at a small number of meditation centres and forest hermitages, but always by prior arrangement. Lay retreat centres such as Nilambe take visitors with little formality. Forest hermitages such as Nissarana Vanaya (Mitirigala) ask for a written request well in advance and set rules on length of stay and who may stay where.' },
  { q: 'Do monasteries charge for stays?', a: 'Traditional monasteries do not charge; they run on dāna (donations). Offer what you can at the end of your stay. Some lay centres ask a fixed daily contribution to cover food.' },
  { q: 'What should I wear to a temple in Sri Lanka?', a: 'White or light-coloured, loose clothing that covers shoulders and knees. Remove shoes and hats before entering shrine areas. Never pose with your back to a Buddha statue for photos.' },
];
---
<Base
  title="Buddhist Monasteries & Meditation Retreats in Sri Lanka"
  description="A careful, sourced guide to Sri Lanka's forest monasteries, sacred temples and the few places you can actually stay and meditate, with etiquette and how to request a stay."
  path="/sacred"
  jsonld={[breadcrumbs(crumbs), faqPage(faq)]}
>
  <Breadcrumbs items={crumbs} />
  <h1 class="text-3xl sm:text-4xl font-semibold">Sacred &amp; Silent</h1>
  <p class="mt-3 text-lg text-ink/80">Sri Lanka has kept a living tradition of forest meditation for over two thousand years. This is a guide to the places where that tradition can still be seen, and to the few where a visitor can quietly join in.</p>

  <div class="mt-6 grid gap-6 md:grid-cols-[1fr_240px] items-start">
    <div class="prose-body">
      <h2>How a monastery stay works</h2>
      <p><strong>Ask first, in writing.</strong> Hermitages are homes for monks, not guesthouses. Write (or email, where an address is published) well ahead, say who you are, what meditation experience you have and how long you'd like to stay. Some places only accept men in the monastery itself, with women staying at a separate retreat centre.</p>
      <p><strong>Expect a monastic day.</strong> A typical day starts around 4 or 4:30 am, includes long periods of sitting and walking meditation, and has one or two meals, the last before noon. Many places ask you to keep the eight precepts: no food after midday, no entertainment or adornment, and noble silence.</p>
      <p><strong>Give, don't pay.</strong> Monasteries run on <em>dāna</em>, freely given support. There's no bill; leave a donation at the end that reflects what you were given.</p>
      <p><strong>Ancient sites are for visiting, not staying.</strong> The ruined forest monasteries such as Ritigala and Arankele are archaeological sites. Visit quietly in the early morning, when they're at their most atmospheric.</p>
      <h2>Etiquette primer</h2>
      <ul>
        <li>Wear white or light, loose clothing covering shoulders and knees.</li>
        <li>Remove shoes and hats before shrine areas; bring socks for hot stone.</li>
        <li>Don't point your feet at monks or Buddha images; sit lower than monks.</li>
        <li>Ask before photographing monks; never pose with your back to a Buddha.</li>
        <li>Women should not touch or hand items directly to monks.</li>
      </ul>
      <p class="text-sm text-muted">We don't sell anything on these pages except, where clearly marked, retreats at lay meditation centres. Forest hermitages are not products.</p>
    </div>
    <figure class="rounded-2xl border border-line bg-white p-3 md:sticky md:top-20">
      <StaticMap zones={climate} scores={neutral} monasteries={monasteries} width={220} className="w-full h-auto" title="Map of monasteries in Sri Lanka" />
      <figcaption class="text-xs text-muted mt-1">◆ {monasteries.length} sacred sites</figcaption>
    </figure>
  </div>

  {groups.map((g) => (
    <section class="mt-10">
      <h2 class="text-2xl font-semibold mb-3">{g.title}</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {monasteries.filter((m) => g.kinds.includes(m.kind)).map((m) => (
          <div>
            <MonasteryCard monastery={m} compact />
            <p class="text-xs text-muted mt-1 ml-1">Near {placeById.get(m.nearPlace)?.name} · <a href={paths.monastery(m.slug)}>Full details →</a></p>
          </div>
        ))}
      </div>
    </section>
  ))}

  <FaqBlock items={faq} />
  <RelatedLinks groups={[
    { title: 'All sites', links: monasteries.map((m) => ({ href: paths.monastery(m.slug), label: m.name })) },
    { title: 'Buddhist itineraries', links: [7, 10, 14].map((d) => ({ href: paths.durationInterest(d, 'buddhist'), label: `${d} days` })) },
  ]} />
</Base>
