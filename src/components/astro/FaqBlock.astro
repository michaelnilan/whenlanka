---
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = 'FAQ' } = Astro.props;
---
<section class="mt-10" aria-labelledby="faq">
  <h2 id="faq" class="text-2xl font-semibold mb-3">{heading}</h2>
  <div class="divide-y divide-line rounded-2xl border border-line bg-white">
    {items.map(({ q, a }) => (
      <details class="group p-4">
        <summary class="cursor-pointer font-medium list-none flex justify-between gap-3">
          {q}<span class="text-muted group-open:rotate-45 transition" aria-hidden="true">+</span>
        </summary>
        <p class="mt-2 text-[15px] leading-relaxed text-ink/90">{a}</p>
      </details>
    ))}
  </div>
</section>
