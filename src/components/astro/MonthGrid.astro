---
import { ALL_MONTHS, monthName, scoreZones } from '../../engine';
import { climate } from '../../lib/data';
import { paths } from '../../lib/slugs';
import { SCORE_COLOR } from '../colors';
const cards = ALL_MONTHS.map((m) => {
  const { scores, best } = scoreZones(m, climate);
  const good = climate.filter((z) => scores[z.id] === 3).map((z) => z.name);
  return { m, best: climate.find((z) => z.id === best)!.name, good, scores };
});
---
<div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
  {cards.map((c) => (
    <a href={paths.month(c.m)} class="block rounded-2xl border border-line bg-white p-4 no-underline text-ink hover:border-teal transition">
      <p class="font-semibold text-lg" style="font-family: var(--font-display)">{monthName(c.m)}</p>
      <div class="flex gap-0.5 my-2" aria-hidden="true">
        {climate.map((z) => <span class="h-2 flex-1 rounded-full" style={`background:${SCORE_COLOR[c.scores[z.id]]}`} title={z.name} />)}
      </div>
      <p class="text-sm text-muted">Best: <span class="text-ink">{c.best}</span></p>
    </a>
  ))}
</div>
