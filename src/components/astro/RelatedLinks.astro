---
interface Props { groups: { title: string; links: { href: string; label: string }[] }[] }
const { groups } = Astro.props;
---
<section class="mt-10" aria-label="Related pages">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {groups.filter((g) => g.links.length).map((g) => (
      <div>
        <h2 class="text-lg font-semibold mb-2">{g.title}</h2>
        <ul class="flex flex-wrap gap-1.5">
          {g.links.map((l) => (
            <li><a href={l.href} class="inline-block text-sm px-2.5 py-1 rounded-full border border-line bg-white no-underline hover:border-teal">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
